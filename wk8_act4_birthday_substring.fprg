<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="wk8_act4_birthday_substring"/>
        <attribute name="authors" value="Mavekencaitlee"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-04 08:28:50 PM"/>
        <attribute name="created" value="TWF2ZWtlbmNhaXRsZWU7REVTS1RPUC1QTzlLOFZVOzIwMjYtMDktMDQ7MTE6NDM6MTEgQU07MzgwMg=="/>
        <attribute name="edited" value="TWF2ZWtlbmNhaXRsZWU7REVTS1RPUC1QTzlLOFZVOzIwMjYtMDktMDQ7MDE6MTU6MjMgUE07MTszOTI2"/>
        <attribute name="edited" value="bWF2ZXJpY2s7TUFWRVJJQ0stLUFDRVItOzIwMjYtMDktMDQ7MDg6Mjg6NTAgUE07NzszMjY2"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Maverick M. Mesare * IT261 * September 4, A.Y. 2026-2027"/>
            <comment text="This file may or may not be shared publicly for learning/reference purposes."/>
            <comment text="DO NOT copy, repost, or submit this code as your own without permission."/>
            <declare name="name, currentDate, birthday, month, day, year, birthdayMD, MaverickMesare" type="String" array="False" size=""/>
            <comment text="users follow the format or else the program will produce an error"/>
            <output expression="&quot;Pls type date in MM/DD/YYYY format. (e.g. 08/25/1985)&quot;" newline="True"/>
            <comment text="the program waits here for you to enter required inputs to proceed"/>
            <input variable="name"/>
            <input variable="currentDate"/>
            <input variable="birthday"/>
            <comment text="functions are called here below to initiate selecting parts of the birthday string"/>
            <assign variable="month" expression="substring(birthday,1,2)"/>
            <assign variable="day" expression="substring(birthday,4,2)"/>
            <assign variable="year" expression="substring(birthday,7,4)"/>
            <comment text="below sets day and month for later comparison through if/else statement"/>
            <assign variable="birthdayMD" expression="month &amp; &quot;/&quot; &amp; day"/>
            <output expression="&quot;You were born in the year &quot; &amp; year &amp; &quot; and the month &quot; &amp; month &amp; &quot; and the day &quot; &amp; day" newline="True"/>
            <comment text="includes additional unique responses based on a person's name (e.g. Mizuki)."/>
            <comment text="If the inputted name is Mizuki, it will output another message based on the conditions."/>
            <comment text="currently, there are 2 unique messages you can discover"/>
            <if expression="substring(currentDate,1,5) = birthdayMD">
                <then>
                    <output expression="&quot;HAPPY BIRTHDAYYYY&quot;" newline="True"/>
                    <if expression="name = &quot;Mizuki&quot;">
                        <then>
                            <output expression="&quot;''YIPEEE, thank you!! WHERE'S THE CAKE?? (o&#12526;o) &#55357;&#56469;'' Mizuki responded as she celebrates with joys&quot;" newline="True"/>
                        </then>
                        <else/>
                    </if>
                </then>
                <else>
                    <output expression="&quot;It ain't ur bday yet, we gotta wait.&quot;" newline="True"/>
                    <if expression="name = &quot;Mizuki&quot;">
                        <then>
                            <output expression="&quot;''awwwwwww bummers hmph! (&#172;`&#8248;&#180;&#172;)'' Mizuki reacts, pouting&quot;" newline="True"/>
                        </then>
                        <else/>
                    </if>
                </else>
            </if>
            <comment text="Maverick M. Mesare * IT261 * September 4, A.Y. 2026-2027"/>
        </body>
    </function>
    <function name="substring" type="String" variable="result">
        <parameters>
            <parameter name="text" type="String" array="False"/>
            <parameter name="startPos" type="Integer" array="False"/>
            <parameter name="numChars" type="Integer" array="False"/>
        </parameters>
        <body>
            <comment text="allows us to select a piece of text from a string"/>
            <declare name="result" type="String" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="result" expression="&quot;&quot;"/>
            <for variable="i" start="startPos" end="startPos + numChars - 1" direction="inc" step="1">
                <assign variable="result" expression="result &amp; Char(text, i - 1)"/>
            </for>
        </body>
    </function>
</flowgorithm>
